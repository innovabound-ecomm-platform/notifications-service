# Notifications Service Environment Variables

# Server
PORT=3011
NODE_ENV=development

# Database
NOTIFICATIONS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notifications

# Auth Service (for JWKS)
AUTH_SERVICE_URL=http://localhost:8003

# Kafka
KAFKA_BROKERS=localhost:9092

# Email Service Integration (optional)
EMAIL_SERVICE_URL=http://localhost:3018
